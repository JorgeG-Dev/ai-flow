# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore NixOS interactive test driver history
**/.nixos-test-history

# Ignore personal claude configs
.claude/settings.local.json

# Ignore OpenSpec output — generated locally, not tracked by this template.
# Projects built from this template should remove these lines; see README.
openspec/
.claude/commands/opsx/
.claude/skills/openspec-*/
