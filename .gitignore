# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore NixOS interactive test driver history
**/.nixos-test-history

# Ignore personal claude configs
.claude/settings.local.json

# OpenSpec generated bindings — regenerate with `openspec init`.
# Safe to keep ignored in projects built from this template.
.claude/commands/opsx/
.claude/skills/openspec-*/

# OpenSpec specs and change artifacts. Ignored here only because the template
# has no changes of its own — real projects should track these. See README.
openspec/
